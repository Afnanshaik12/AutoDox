{
  "name": "autodox-ai",
  "version": "1.0.0",
  "description": "AutoDox AI - Chrome extension for intelligent document processing and real-time form autofill",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/src/index.js",
    "server:dev": "node --watch server/src/index.js",
    "test": "node server/tests/auth.test.js && node server/tests/vault.test.js && node server/tests/extension.test.js",
    "check:supabase": "node server/scripts/verify-supabase.js",
    "build": "vite build && node scripts/build-scripts.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "vite": "^5.4.14"
  }
}
