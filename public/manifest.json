{
  "manifest_version": 3,
  "name": "AutoDox AI - Document Intelligence & Autofill",
  "version": "1.0.0",
  "description": "Secure, privacy-first document intelligence and real-time form autofill companion.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://autodox-backend.onrender.com/*",
    "http://localhost:5001/*",
    "http://127.0.0.1:5001/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open AutoDox AI"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "demo-form.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
